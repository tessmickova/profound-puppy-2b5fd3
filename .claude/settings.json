{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/nasazeni-jen-z-githubu.sh\"",
            "timeout": 30,
            "statusMessage": "Kontroluji, že nasazovaný kód je na GitHubu…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/nahraj-na-github.sh\"",
            "timeout": 60,
            "statusMessage": "Nahrávám hotové commity na GitHub…"
          }
        ]
      }
    ]
  }
}
