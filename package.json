{
  "name": "auroradog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev --local",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy",
    "test": "npx tsx --test testy/*.test.ts",
    "kontrola:data": "npx tsx skripty/kontrola-dat.ts",
    "prebuild": "npm run kontrola:data",
    "kontrola": "npm run typecheck && npm run kontrola:data && npm test",
    "indexnow": "npx tsx skripty/indexnow.ts",
    "kontrola:seo": "npx tsx skripty/kontrola-seo.ts",
    "klicova-slova": "npx tsx skripty/klicova-slova.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
    "swr": "^2.5.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.1"
  },
  "engines": {
    "node": ">=22"
  }
}
