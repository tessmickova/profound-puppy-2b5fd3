{
  "name": "svetjmen-ads",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml",
    "deploy": "wrangler deploy -c wrangler.toml",
    "db:schema": "wrangler d1 execute svetjmen-ads --remote -c wrangler.toml --file=./schema.sql",
    "db:schema:local": "wrangler d1 execute svetjmen-ads --local -c wrangler.toml --file=./schema.sql",
    "db:migrace-003": "wrangler d1 execute svetjmen-ads --remote -c wrangler.toml --file=./migrace/003-nastaveni.sql",
    "db:migrace-003:local": "wrangler d1 execute svetjmen-ads --local -c wrangler.toml --file=./migrace/003-nastaveni.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.28.0"
  }
}
