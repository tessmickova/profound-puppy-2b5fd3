// Nasazení webu Svět jmen (a s ním i AuroraDog na /aurora).
//
// Reklamy tady schválně nejsou — mají vlastní nasazení v ads-worker/,
// aby jejich výpadek nikdy nepoložil web.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svetjmen",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Veřejná adresa webu — používá ji sitemap, robots a JSON-LD.
    // Dokud neběží vlastní doména, míří na adresu, kde web opravdu je.
    // Náhled na workers.dev se sám označí jako neindexovatelný, aby vedle
    // budoucí produkční domény nevznikla druhá kopie webu.
    "NEXT_PUBLIC_URL": "https://svetjmen.tereza-holtzerova.workers.dev",
    // Adresa reklamní služby. Prázdná hodnota = reklamy se nevykreslí.
    // Dokud nemáme vlastní doménu, míří na workers.dev adresu služby; po
    // překlopení domény sem patří https://reklama.jmenaprodeti.cz.
    "NEXT_PUBLIC_ADS_API": "https://svetjmen-ads.tereza-holtzerova.workers.dev",
    "NEXT_PUBLIC_PROVOZOVATEL": "Vítězslav Miček",
    "NEXT_PUBLIC_ICO": "07347219",
    "NEXT_PUBLIC_SIDLO": "Těšínská 1240/50b, Havířov",
    "NEXT_PUBLIC_DIC": "",
    "NEXT_PUBLIC_PLATCE_DPH": "0",
    "NEXT_PUBLIC_UCET": "VYPLNIT/0000",
    "NEXT_PUBLIC_KONTAKT": "info@jmenaprodeti.cz",
    "NEXT_PUBLIC_KONTAKT_REKLAMA": "reklama@jmenaprodeti.cz"
  }
  // Tajemství (Supabase, NASA, Telegram, WhatsApp, CRON_SECRET — všechno pro
  // AuroraDog) se nastavují přes `wrangler secret put`, nikdy sem.
}
